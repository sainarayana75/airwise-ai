# AirWise AI Environment Configuration
# Copy this file to .env for local development

# Google Gemini API Key (Required for live GenAI assistant features)
# If omitted, AirWise AI gracefully falls back to its deterministic intelligent rule engine
GEMINI_API_KEY=your_gemini_api_key_here

# Optional: Model selection (defaults to gemini-1.5-flash)
GEMINI_MODEL=gemini-1.5-flash
